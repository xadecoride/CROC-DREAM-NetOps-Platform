{% for iface in intent.interfaces %}
interface {{ iface.name }}
{% if iface.description %}
  description "{{ iface.description }}"
{% endif %}
{% if iface.mtu != 1500 %}
  mtu {{ iface.mtu }}
{% endif %}
{% if iface.ipv4_address %}
  ip address {{ iface.ipv4_address.ip }}/{{ iface.ipv4_address.network.prefixlen }}
{% endif %}
{% if iface.acl_in %}
  ip access-group {{ iface.acl_in }} in
{% endif %}
{% if not iface.enabled %}
  shutdown
{% else %}
  no shutdown
{% endif %}
exit
{% endfor %}
