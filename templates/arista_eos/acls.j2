{% for acl in intent.acls %}
ip access-list {{ acl.name }}
{% for rule in acl.rules %}
{% set src = rule.source if rule.source is defined else 'any' %}
{% set dst = rule.destination if rule.destination is defined else 'any' %}
{% if rule.src_port is defined and rule.src_port %}
   {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }} {{ src }} eq {{ rule.src_port }} {{ dst }}
{% elif rule.dst_port is defined and rule.dst_port %}
   {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }} {{ src }} {{ dst }} eq {{ rule.dst_port }}
{% else %}
   {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }} {{ src }} {{ dst }}
{% endif %}
{% endfor %}
{% endfor %}
