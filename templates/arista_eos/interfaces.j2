{% set declared = intent.interfaces | map(attribute="name") | join(" ") | lower %}
{% if intent.bgp and "loopback" not in declared %}
interface Loopback0
   description Router-ID
   ip address {{ intent.bgp.router_id }}/32
{% endif %}
{% for iface in intent.interfaces %}
interface {{ iface.name }}
{% if iface.description %}
   description {{ iface.description }}
{% endif %}
{% if iface.mtu != 1500 %}
   mtu {{ iface.mtu }}
{% endif %}
{% if iface.mode == "l3" and not iface.name.startswith("Loopback") %}
   no switchport
{% elif iface.mode == "l2" %}
   switchport
{% if iface.access_vlan %}
   switchport access vlan {{ iface.access_vlan }}
{% endif %}
{% endif %}
{% if iface.ipv4_address %}
   ip address {{ iface.ipv4_address.with_prefixlen }}
{% endif %}
{% if not iface.name.lower().startswith("loopback") %}
{% if iface.acl_in %}
   ip access-group {{ iface.acl_in }} in
{% endif %}
{% endif %}
{% if iface.ospf_area is not none %}
{% if not iface.name.lower().startswith("loopback") %}
   ip ospf network point-to-point
{% endif %}
   ip ospf area {{ iface.ospf_area }}
{% endif %}
{% if not iface.enabled %}
   shutdown
{% endif %}
{% endfor %}
