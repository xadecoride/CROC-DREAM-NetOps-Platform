{% for iface in intent.interfaces %}
interface {{ iface.name }}
{% if iface.mode == "l2" %}
{% if iface.description %}
 description {{ iface.description }}
{% endif %}
{% if iface.access_vlan %}
 port default vlan {{ iface.access_vlan }}
 stp edged-port enable
{% endif %}
{% elif iface.name.lower().startswith("vbdif") %}
{% if iface.description %}
 description {{ iface.description }}
{% endif %}
{% if iface.ipv4_address %}
 ip address {{ iface.ipv4_address.ip }} {{ iface.ipv4_address.netmask }}
{% endif %}
 arp distribute-gateway enable
{% else %}
{% if not iface.name.lower().startswith("loopback") %}
 undo portswitch
{% endif %}
{% if iface.description %}
 description {{ iface.description }}
{% endif %}
{% if iface.ipv4_address %}
 ip address {{ iface.ipv4_address.ip }} {{ iface.ipv4_address.netmask }}
{% endif %}
{% if iface.acl_in %}
 traffic-filter inbound acl name {{ iface.acl_in }}
{% endif %}
{% if iface.ospf_area is not none and not iface.name.lower().startswith("loopback") %}
 ospf network-type p2p
{% endif %}
{% endif %}
{% if not iface.name.lower().startswith(("loopback", "vbdif")) %}
{% if iface.enabled %}
 undo shutdown
{% else %}
 shutdown
{% endif %}
{% endif %}
{% endfor %}
{% if intent.bgp and intent.bgp.vxlan_vni %}
interface Nve1
 description VXLAN VTEP
 source {{ intent.bgp.router_id }}
 vni {{ intent.bgp.vxlan_vni }} head-end peer-list protocol bgp
{% endif %}
