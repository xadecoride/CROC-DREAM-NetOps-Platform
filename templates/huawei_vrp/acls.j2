{% for acl in intent.acls %}
acl name {{ acl.name }} advance
{% for rule in acl.rules %}
{% if rule.dst_port is defined and rule.dst_port %}
 rule {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }} destination-port eq {{ rule.dst_port }}
{% elif rule.src_port is defined and rule.src_port %}
 rule {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }} source-port eq {{ rule.src_port }}
{% else %}
 rule {{ rule.sequence }} {{ rule.action }} {{ rule.protocol }}
{% endif %}
{% endfor %}
{% endfor %}
