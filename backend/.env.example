# Скопировать в .env и поправить. Все переменные с префиксом NETOPS_.

NETOPS_DATABASE_URL=postgresql+psycopg://netops:netops@localhost:5432/netops
NETOPS_REDIS_URL=redis://localhost:6379/0

# Рабочая копия репозитория intent (inventory.yaml + devices/<hostname>.yaml)
NETOPS_INTENT_REPO_PATH=../intent
# Шаблоны Jinja2: <путь>/<платформа>/{base,interfaces,acls,bgp}.j2
NETOPS_TEMPLATES_PATH=../templates
# Дополнительные правила нормализации (необязательно)
# NETOPS_NORMALIZATION_RULES_PATH=../normalization.yaml

# offline — стенд на файлах <NETOPS_OFFLINE_LAB_PATH>/<hostname>.cfg
NETOPS_NETWORK_DRIVER=offline
NETOPS_OFFLINE_LAB_PATH=../lab/running

NETOPS_COMMIT_CONFIRM_TIMEOUT_SECONDS=180
NETOPS_MAX_PING_LOSS_PERCENT=20
# Повторы post-check, пока сходится BGP (не больше половины таймера commit confirmed)
NETOPS_POST_CHECK_ATTEMPTS=6
NETOPS_POST_CHECK_INTERVAL_SECONDS=10
NETOPS_DRIFT_SCAN_INTERVAL_SECONDS=900
NETOPS_JOB_TIMEOUT_SECONDS=3600

# Начальные токены API: пользователь и роль (viewer | operator | admin). Только для разработки!
# Остальных пользователей админ заводит через POST /api/v1/users.
NETOPS_API_TOKENS='{"dev-admin-token": {"username": "admin", "role": "admin"}, "dev-operator-token": {"username": "operator", "role": "operator"}, "dev-viewer-token": {"username": "viewer", "role": "viewer"}}'

# SSH-учётки для Device.auth_profile
NETOPS_AUTH_PROFILES='{"lab": {"username": "admin", "password": "admin"}}'

# Адреса веб-интерфейса, которым разрешены запросы из браузера
NETOPS_CORS_ORIGINS='["http://localhost:5173"]'

# LLM Risk Assistant (Xiaomi MiMo-V2.6-Flash or any OpenAI-compatible provider)
# NETOPS_LLM_API_KEY=sk-...
# NETOPS_LLM_BASE_URL=https://api.hcnsec.cn/v1
# NETOPS_LLM_MODEL=MiMo-V2.6-Flash
